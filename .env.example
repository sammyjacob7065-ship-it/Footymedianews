# Token used to authenticate n8n -> /api/create-post requests
CREATE_POST_TOKEN=change-me-to-a-long-random-string

# GitHub repo the API route commits new .mdx posts to
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=your-github-username
GITHUB_REPO=ai-football-house
GITHUB_BRANCH=main

# AdSense (leave unset and the site shows placeholder boxes instead of real ads)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-your-publisher-id
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=your-header-ad-unit-id
NEXT_PUBLIC_ADSENSE_SLOT_FEED=your-feed-ad-unit-id
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=your-article-ad-unit-id

# Your live site URL, used in metadata, sitemap.xml, robots.txt and feed.xml
NEXT_PUBLIC_SITE_URL=https://football-media-news.vercel.app

# Comments — uses the same Supabase project as your n8n workflow.
# Service role key stays server-only, never exposed to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
